#!/usr/bin/env bash
# Image tests, run by docker-image-refresh after building a new image and
# before tagging it 'latest'. Usage: ./test <image>

# The check functions are called indirectly, through 'check'
# shellcheck disable=SC2329

set -euo pipefail

if [ $# -ne 1 ]; then
    echo "Usage: $0 <image>" >&2
    exit 2
fi
IMAGE=$1

REPO_DIR=$(dirname "$0")
PYTHON=/opt/virtualenv/bin/python
FAILED=0
CONTAINER="sungather-test-$$"
WAITING_CONTAINER="sungather-test-waiting-$$"

# No inverter answers on localhost, but with its model and serial number set
# SunGather still loads its registers and exports, and starts its webserver
CONFIG='inverter:
  host: 127.0.0.1
  connection: modbus
  model: SG5K-D
  serial: TEST
  scan_interval: 5
exports:
  - name: webserver
    enabled: True'

# Without them, SunGather has to wait for the inverter to detect them, and
# mustn't load its exports meanwhile
WAITING_CONFIG='inverter:
  host: 127.0.0.1
  connection: modbus
  scan_interval: 5
  log_console: INFO
exports:
  - name: webserver
    enabled: True'

cleanup() {
    docker rm --force "$CONTAINER" "$WAITING_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT

check() {
    local name=$1 output
    shift
    if output=$("$@" 2>&1); then
        echo "PASS: $name"
    else
        echo "FAIL: $name"
        [ -z "$output" ] || echo "    ${output//$'\n'/$'\n'    }"
        FAILED=1
    fi
}

in_image() {
    docker run --rm "$IMAGE" "$@"
}

runs_as_sungather() {
    local user
    user=$(in_image id -un) || return 1
    [ "$user" = "sungather" ] || { echo "Runs as '$user'"; return 1; }
}

imports_dependencies() {
    in_image "$PYTHON" -c 'import yaml, paho.mqtt.client, requests, influxdb_client, SungrowClient.SungrowClient'
}

has_patched_sungrowclient() {
    local path
    path=$(in_image "$PYTHON" -c 'import SungrowClient.SungrowClient as m; print(m.__file__)') || return 1
    in_image cat "$path" | cmp - "$REPO_DIR/patch/SungrowClient.py"
}

start_container() {
    docker run --detach --name "$1" "$IMAGE" sh -c \
        'printf "%s\n" "$0" > /tmp/config.yaml && exec '"$PYTHON"' sungather.py -c /tmp/config.yaml -l /tmp/' \
        "$2" >/dev/null
}

starts() {
    start_container "$CONTAINER" "$CONFIG"
}

# Polls the image's healthcheck rather than waiting for Docker to run it
passes_healthcheck() {
    for _ in {1..15}; do
        docker exec "$1" healthcheck && return 0
        sleep 2
    done
    docker logs --tail 20 "$1"
    return 1
}

healthy_without_inverter() {
    passes_healthcheck "$CONTAINER"
}

waits_for_inverter() {
    start_container "$WAITING_CONTAINER" "$WAITING_CONFIG" || return 1
    passes_healthcheck "$WAITING_CONTAINER" || return 1
    docker logs "$WAITING_CONTAINER" 2>&1 | grep -q 'Inverter is not answering' \
        || { docker logs --tail 20 "$WAITING_CONTAINER"; return 1; }
    ! docker logs "$WAITING_CONTAINER" 2>&1 | grep 'Loading Export'
}

serves_webpage() {
    local page
    for _ in {1..30}; do
        if page=$(docker exec "$CONTAINER" "$PYTHON" -c \
            'import urllib.request; print(urllib.request.urlopen("http://localhost:8080/", timeout=3).read().decode())' 2>/dev/null); then
            grep -q '<title>SunGather</title>' <<<"$page" && return 0
            echo "$page" | head -20
            return 1
        fi
        sleep 2
    done
    docker logs --tail 20 "$CONTAINER"
    return 1
}

# Fails when Debian's repositories can't be reached, as well as when
# packages are out of date
packages_up_to_date() {
    local output
    # Passes on the proxy settings where there's one, as in the devcontainer
    output=$(docker run --rm --user root -e http_proxy -e https_proxy "$IMAGE" sh -c \
        'apt-get update -qq --error-on=any && apt-get -s -q --with-new-pkgs upgrade' 2>&1) \
        || { echo "$output"; return 1; }
    ! grep '^Inst ' <<<"$output"
}

echo "Testing '$IMAGE' ..."
check "runs as the sungather user" runs_as_sungather
check "Python dependencies import" imports_dependencies
check "patched SungrowClient is installed" has_patched_sungrowclient
check "container starts" starts
check "serves its web page without an inverter" serves_webpage
check "passes its healthcheck without an inverter" healthy_without_inverter
check "waits for the inverter to detect its model" waits_for_inverter
check "Debian packages are up to date" packages_up_to_date

exit $FAILED
